# Copy to .env.local for local dev, or set these in the host dashboard.
# Every variable is optional: the site builds and runs with none of them.

# Canonical origin. Defaults to https://palmgrove.jayleadagro.com (src/lib/site.ts).
NEXT_PUBLIC_SITE_URL=

# Leads, option 1: HubSpot Forms API v3 (portal ID + one form GUID per form).
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_PRICING=
HUBSPOT_FORM_BROCHURE=

# Leads, option 2 (also the fallback if HubSpot fails): email via Resend.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=            # comma-separate several inboxes
LEAD_FROM_EMAIL=              # once jayleadagro.com is verified in Resend

# Ad tracking. Each script loads only when its ID is set.
NEXT_PUBLIC_META_PIXEL_ID=    # digits only
NEXT_PUBLIC_GA_ID=            # G-… or AW-…
